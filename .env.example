# 복사해서 .env 로. 거래소 키는 '출금' 권한 없이 발급하고, 업비트는 서버 고정 IP를 허용 IP에 등록.
# 빈 값(`QP_X=`)은 "설정 안 함"이다 — 화면에서 등록한 키(data/keys.env)를 덮지 않는다 (ADR 0029)
QP_ENV=dev
QP_PAPER=true
# 로그 형식 text/json — 배포 compose는 json (docs/07 §5)
QP_LOG_FORMAT=text
QP_DATA_DIR=data
QP_INITIAL_CASH_KRW=10000000
QP_INITIAL_CASH_USD=10000
QP_JUDGE_PROVIDER=stub
# LLM 2모델 합의 — JSON 목록으로 쓴다(쉼표 목록은 시작 실패). 키가 없으면 stub 그대로
# QP_LLM_PROVIDERS=["claude","gemini"]
QP_GATE_HOLD_BELOW=0.5
QP_GATE_FULL_ABOVE=0.9
QP_HOLDOUT_MONTHS=12
# 하루 AI 비용 상한(USD) — 넘으면 LLM 합의 중단(= hold), 판단 모델은 계속 (06 §7)
# QP_AI_BUDGET_USD_DAILY=2.0

# API 로그인 (03 §1, 07 §2). 시크릿은 32바이트 이상
QP_ADMIN_PASSWORD=
QP_JWT_SECRET=
# 로그인 유지 시간(시간)
# QP_JWT_TTL_HOURS=12
# 실시간 허브 (비우면 프로세스 내 MemoryHub, ADR 0017)
QP_REDIS_URL=

QP_UPBIT_ACCESS_KEY=
QP_UPBIT_SECRET_KEY=
QP_KIS_APP_KEY=
QP_KIS_APP_SECRET=
QP_KIS_ACCOUNT=
QP_ALPACA_KEY=
QP_ALPACA_SECRET=
QP_TYPESAFE_API_KEY=
QP_ANTHROPIC_API_KEY=
QP_GOOGLE_API_KEY=
QP_DART_API_KEY=
# 뉴스·이벤트 (ADR 0021). 비우면 기본 피드 설정, 이벤트 파일이 없으면 빈 캘린더
QP_NEWS_FILE=
# QP_EVENTS_FILE: 로컬 실행용. paper compose는 deploy/events.yaml을 꽂고 이 값을 덮어쓴다
QP_EVENTS_FILE=data/events.yaml
# 알림 (07 §6). 비어 있으면 로그로만
QP_TELEGRAM_BOT_TOKEN=
QP_TELEGRAM_CHAT_ID=

# docker compose. 운영(deploy/compose.yml)은 값이 없으면 시작하지 않는다 — URL 안전 문자로 (openssl rand -hex 24)
POSTGRES_PASSWORD=
# compose만 읽는 값 — 바꿀 때 주석을 푼다. 이미지 태그는 env가 아니라 deploy.sh --tag로 (07 §2.1)
# QP_API_PORT=8000
# QP_WEB_PORT=3000
# 브라우저 WS 주소. HTTPS 앞단을 둔 뒤 wss://<도메인>/api/v1/ws. QP_API_PORT를 바꾸면 여기 포트도 바꾼다
# QP_WS_URL=ws://127.0.0.1:8000/api/v1/ws
# TimescaleDB 이미지(기본 latest-pg16). 첫 배포 뒤 그때 받은 버전 태그로 고정하면 복원 때 버전이 맞는다
# QP_TIMESCALE_IMAGE=
