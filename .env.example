# 복사해서 .env 로. 거래소 키는 '출금' 권한 없이 발급하고, 업비트는 서버 고정 IP를 허용 IP에 등록.
QP_ENV=dev
QP_PAPER=true
QP_DATA_DIR=data
QP_INITIAL_CASH_KRW=10000000
QP_INITIAL_CASH_USD=10000
QP_JUDGE_PROVIDER=stub
QP_GATE_HOLD_BELOW=0.5
QP_GATE_FULL_ABOVE=0.9
QP_HOLDOUT_MONTHS=12

QP_UPBIT_ACCESS_KEY=
QP_UPBIT_SECRET_KEY=
QP_KIS_APP_KEY=
QP_KIS_APP_SECRET=
QP_KIS_ACCOUNT=
QP_ALPACA_KEY=
QP_ALPACA_SECRET=
QP_TYPESAFE_API_KEY=
QP_ANTHROPIC_API_KEY=
QP_GOOGLE_API_KEY=
# 알림 (07 §6). 비어 있으면 로그로만
QP_TELEGRAM_BOT_TOKEN=
QP_TELEGRAM_CHAT_ID=

# docker compose
POSTGRES_PASSWORD=quantpilot
